{
  "name": "@gscombat/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "generate:showcase-metadata": "tsx tools/generate-showcase-metadata.ts",
    "invite": "tsx src/manage-invites.ts",
    "start": "node dist/server.js",
    "test": "vitest run --maxWorkers=4 --testTimeout=60000 --hookTimeout=60000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gscombat/analyzer": "workspace:*",
    "@gscombat/calculator": "workspace:*",
    "@gscombat/content": "workspace:*",
    "@gscombat/contracts": "workspace:*",
    "@gscombat/game-data": "workspace:*",
    "fastify": "5.10.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "undici": "7.28.0",
    "vitest": "4.1.10"
  }
}
