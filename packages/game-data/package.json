{
  "name": "@gscombat/game-data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "genshin-db:evaluate": "tsx tools/genshin-db/cli.ts",
    "genshin-db:map:check": "tsx tools/genshin-db/semantic-check.ts",
    "build": "tsc -p tsconfig.build.json",
    "semantic-preview:import": "tsx tools/import-semantic-localization-preview.ts",
    "snapshot:update": "tsx tools/update-snapshot.ts",
    "snapshot:update:7.1": "tsx tools/update-7.1.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "undici": "7.28.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
