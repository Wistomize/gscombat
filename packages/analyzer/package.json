{
  "name": "@gscombat/analyzer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --maxWorkers=4 --testTimeout=45000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gscombat/calculator": "workspace:*",
    "@gscombat/content": "workspace:*",
    "@gscombat/contracts": "workspace:*",
    "@gscombat/game-data": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
