{
  "name": "@gscombat/content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./authoring-catalog": {
      "types": "./dist/authoring-catalog.d.ts",
      "import": "./dist/authoring-catalog.js"
    },
    "./weapon-names": {
      "types": "./dist/weapon-names.d.ts",
      "import": "./dist/weapon-names.js"
    }
  },
  "scripts": {
    "build": "pnpm registries:check && tsc -p tsconfig.build.json",
    "registries:check": "node --experimental-strip-types tools/generate-registries.ts --check",
    "registries:generate": "node --experimental-strip-types tools/generate-registries.ts",
    "test": "pnpm registries:check && vitest run",
    "typecheck": "pnpm registries:check && tsc --noEmit"
  },
  "dependencies": {
    "@gscombat/calculator": "workspace:*",
    "@gscombat/contracts": "workspace:*"
  },
  "devDependencies": {
    "@gscombat/game-data": "workspace:*",
    "@types/node": "22.20.1",
    "typescript": "6.0.3",
    "undici": "7.28.0",
    "vitest": "4.1.10"
  }
}
